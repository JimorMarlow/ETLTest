/**
 * @file secret.h.example
 * @brief Шаблон файла с секретами для MQTT подключения
 *
 * ИНСТРУКЦИЯ:
 * 1. Скопируйте этот файл в src/secret.h
 * 2. Заполните реальные значения для подключения к wqtt.ru
 * 3. НЕ КОММИТЬТЕ secret.h в репозиторий!
 *
 * Файл secret.h должен храниться в приватном репозитории ETLSecrets
 */

#pragma once

// Настройки подключения к MQTT брокеру wqtt.ru
#define MQTT_BROKER_HOST "m1.wqtt.ru"
#define MQTT_BROKER_PORT 16208

// Логин и пароль для подключения к брокеру
#define MQTT_USERNAME "your_wqtt_username"
#define MQTT_PASSWORD "your_wqtt_password"

// Client ID (можно оставить уникальным для каждого устройства)
#define MQTT_CLIENT_ID "esp_light_001"

// TLS настройки (зарезервировано, пока не используется)
// #define MQTT_USE_TLS
// #define MQTT_TLS_FINGERPRINT ""
