#pragma once
/**
 * @file secret.h.example
 * @brief Шаблон файла с настройками подключения к внешним сервисам 
 *
 * ИНСТРУКЦИЯ:
 * 1. Скопируйте этот файл в src/secret.h
 * 2. Замените placeholder'ы на реальные значения
 * 3. НЕ КОММИТЬТЕ secret.h в открытый репозиторий!
 *
 * Реальный secret хранится в приватном репозитории ETLSecrets
 * и копируется локально при разработке.
 */

// ============================================================================
// MQTT Broker (wqtt.ru)
// ============================================================================

#define MQTT_BROKER_HOST        "m1.wqtt.ru"
#define MQTT_BROKER_PORT        16208
#define MQTT_BROKER_TLS_PORT    16209
#define MQTT_BROKER_WEBSOCKET_TLS_PORT	16211

// Логин и пароль для подключения к брокеру
#define MQTT_USERNAME           "your_wqtt_username"
#define MQTT_PASSWORD           "your_wqtt_password"

// Client ID (можно оставить уникальным для каждого устройства)
#define MQTT_CLIENT_ID          "esp_light_001"

// Флаг наличия секретов (автоматически определяется)
#define HAS_MQTT_SECRETS    1

// TLS настройки (зарезервировано, пока не используется)
// #define MQTT_USE_TLS
// #define MQTT_TLS_FINGERPRINT ""

// ============================================================================
// MQTT Sensors (wqtt.ru)
// ============================================================================
namespace mqtt {
    namespace topic {
        namespace kitchen {
            namespace workarea {
                namespace power // on: 1; off: 0
                {   
                    inline const char* set     = "/home/guest/light/kitchen_workarea/set";
                    inline const char* state   = "/home/guest/light/kitchen_workarea/state";
                }
                namespace brightness // multiplier: 1.0; range [0..100.0]; step: 1.0
                { 
                    inline const char* set     = "/home/guest/light/kitchen_workarea/brightness/set";
                    inline const char* state   = "/home/guest/light/kitchen_workarea/brightness/state";
                }
            }// namespace workarea
        }// namespace kitchen
    }// namespace topic
}// namespace wqtt

