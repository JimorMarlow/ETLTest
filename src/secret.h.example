#pragma once
/**
 * @file secret.h.example
 * @brief Шаблон файла с настройками подключения к MQTT брокеру
 *
 * ИНСТРУКЦИЯ:
 * 1. Скопируйте этот файл в src/secret.h
 * 2. Замените placeholder'ы на реальные значения
 * 3. НЕ КОММИТЬТЕ secret.h в открытый репозиторий!
 *
 * Реальный secret.h хранится в приватном репозитории ETLSecrets
 * и копируется локально при разработке.
 */

// ============================================================================
// MQTT Broker (wqtt.ru)
// ============================================================================

#define MQTT_BROKER_HOST        "m1.wqtt.ru"
#define MQTT_BROKER_PORT        16208           // Порт без TLS
#define MQTT_USERNAME           "u_XXXXXXXX"
#define MQTT_PASSWORD           "your_password_here"
#define MQTT_CLIENT_ID          "esp_kitchen_light"

// ============================================================================
// MQTT Broker TLS (зарезервировано, пока не используется)
// ============================================================================

#define MQTT_BROKER_TLS_PORT    16209           // Порт TLS
#define MQTT_BROKER_WSS_PORT    16211           // WebSocket TLS

// Флаг наличия секретов (автоматически определяется)
#define HAS_MQTT_SECRETS        1
